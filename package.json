{
  "name": "bos-operations-center",
  "version": "0.4.106",
  "private": false,
  "description": "Cross-client source repository for Education Center Agent Skills.",
  "author": "Infinite State Machines LLC",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "version:next": "node scripts/bump-release-version.mjs",
    "build:schema-validator": "node scripts/build-json-schema-meta-validator.mjs",
    "build:journey-runtime": "node scripts/build-journey-runtime-dependencies.mjs",
    "check:schema-validator": "node scripts/build-json-schema-meta-validator.mjs --check",
    "check:journey-runtime": "node scripts/build-journey-runtime-dependencies.mjs --check",
    "build:packages": "npm run build:schema-validator && npm run build:journey-runtime && node scripts/build-packages.mjs",
    "build": "npm run build:packages",
    "check": "npm run check:schema-validator && npm run check:journey-runtime && node scripts/check-package.mjs",
    "check:publication": "node scripts/check-publication-safety.mjs",
    "contract:check": "node scripts/verify-product-mcp-contract.mjs --format json",
    "contract:lead-director:import": "node scripts/import-lead-director-public-contract.mjs",
    "contract:oauth-discovery-live": "node scripts/verify-bos-auth-discovery-live.mjs",
    "contract:oauth-login-trigger-live": "node scripts/verify-bos-login-trigger-live.mjs",
    "contract:oauth-live": "node scripts/verify-bos-oauth-live.mjs",
    "acceptance:codex-login": "node scripts/verify-codex-login-evidence.mjs",
    "acceptance:codex-request-time-login": "node --test acceptance/codex-request-time-login-surface.acceptance.mjs",
    "acceptance:agent-journey-live": "node scripts/verify-agent-driven-journey-live.mjs",
    "acceptance:post-release": "npm run contract:oauth-discovery-live -- --format json && npm run contract:oauth-login-trigger-live -- --format json && npm run acceptance:codex-login -- --json && npm run acceptance:codex-request-time-login",
    "inventory": "node scripts/inventory-skills.mjs",
    "install:inspect": "node scripts/install-package.mjs inspect",
    "install:plan": "node scripts/install-package.mjs plan",
    "install:apply": "node scripts/install-package.mjs apply",
    "install:verify": "node scripts/install-package.mjs verify",
    "install:verify:codex-runtime": "node scripts/verify-codex-runtime.mjs",
    "install:verify:claude-runtime": "node scripts/verify-claude-runtime.mjs",
    "install:verify:gemini-runtime": "node scripts/verify-gemini-runtime.mjs",
    "install:verify:antigravity-runtime": "node scripts/verify-antigravity-runtime.mjs",
    "install:verify:copilot-runtime": "node scripts/verify-copilot-runtime.mjs",
    "install:claude": "node scripts/install-claude-local.mjs",
    "clean-install:codex": "node scripts/clean-install-codex.mjs",
    "clean-install:claude": "node scripts/clean-install-claude.mjs",
    "clean-install:gemini": "node scripts/clean-install-gemini.mjs",
    "clean-install:antigravity": "./scripts/clean-install-antigravity.sh",
    "cache:reset": "./scripts/reset-bos-client-caches.sh",
    "extension:create": "node scripts/create-extension.mjs",
    "dev:link:codex": "node scripts/link-codex-development.mjs",
    "release": "npm run release:check",
    "test": "node --test tests/*.test.mjs",
    "test:authentication": "node --test tests/bos-oauth-live-contract.test.mjs tests/codex-login-surface-contract.test.mjs tests/codex-request-time-login-surface.test.mjs tests/external-authentication-handoff.test.mjs tests/external-dependency-adapter.test.mjs tests/product-mcp-contract.test.mjs tests/codex-runtime-verification.test.mjs tests/installer.test.mjs",
    "release:check": "npm run build && npm run check && npm run contract:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2"
  }
}
