{
  "name": "bos-operations-center",
  "version": "0.4.59",
  "private": false,
  "description": "Cross-client source repository for Education Center Agent Skills.",
  "author": "Infinite State Machines LLC",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "version:next": "node scripts/bump-release-version.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "build": "npm run build:packages",
    "check": "node scripts/check-package.mjs",
    "contract:check": "node scripts/verify-single-bos-contract.mjs --format json",
    "contract:oauth-live": "node scripts/verify-bos-oauth-live.mjs",
    "inventory": "node scripts/inventory-skills.mjs",
    "install:inspect": "node scripts/install-package.mjs inspect",
    "install:plan": "node scripts/install-package.mjs plan",
    "install:apply": "node scripts/install-package.mjs apply",
    "install:verify": "node scripts/install-package.mjs verify",
    "install:verify:codex-runtime": "node scripts/verify-codex-runtime.mjs",
    "install:verify:claude-runtime": "node scripts/verify-claude-runtime.mjs",
    "install:verify:gemini-runtime": "node scripts/verify-gemini-runtime.mjs",
    "install:verify:antigravity-runtime": "node scripts/verify-antigravity-runtime.mjs",
    "install:verify:copilot-runtime": "node scripts/verify-copilot-runtime.mjs",
    "install:claude": "node scripts/install-claude-local.mjs",
    "clean-install:codex": "node scripts/clean-install-codex.mjs",
    "clean-install:claude": "node scripts/clean-install-claude.mjs",
    "clean-install:gemini": "node scripts/clean-install-gemini.mjs",
    "clean-install:antigravity": "./scripts/clean-install-antigravity.sh",
    "cache:reset": "./scripts/reset-bos-client-caches.sh",
    "extension:create": "node scripts/create-extension.mjs",
    "dev:link:codex": "node scripts/link-codex-development.mjs",
    "release": "npm run release:check",
    "test": "node --test tests/*.test.mjs",
    "release:check": "npm run build && npm run check && npm run contract:check && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
