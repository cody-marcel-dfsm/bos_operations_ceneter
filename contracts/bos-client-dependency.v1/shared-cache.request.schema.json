{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bos://contracts/client-dependency/v1/shared-cache-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "query", "window", "refresh_through"],
  "properties": {
    "schema_version": {"const": "bos.shared-cache-consumer/v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "application", "plugin"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "application": {"type": "string", "minLength": 1},
        "plugin": {"type": "string", "minLength": 1}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "resource_kind", "selector", "descriptor_token"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "resource_kind": {"type": "string", "minLength": 1},
        "selector": {"type": "object"},
        "descriptor_token": {"type": "string", "minLength": 1}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "through": {"type": "string", "format": "date-time"}
      }
    },
    "refresh_through": {"type": "string", "format": "date-time"},
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_seconds"],
      "properties": {
        "max_age_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000},
        "allow_stale_on_error": {"type": "boolean", "default": false}
      }
    },
    "lease_token": {"type": "string", "minLength": 1},
    "next_cursor": {"type": ["string", "null"]},
    "covered_intervals": {"type": "array", "items": {"$ref": "#/$defs/window"}},
    "documents": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/live_document"},
          {"$ref": "#/$defs/deleted_document"}
        ]
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "through": {"type": "string", "format": "date-time"}
      }
    },
    "live_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "version", "modified_at", "payload"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "deleted": {"const": false},
        "payload": true
      }
    },
    "deleted_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "version", "modified_at", "deleted"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "deleted": {"const": true}
      }
    }
  }
}
