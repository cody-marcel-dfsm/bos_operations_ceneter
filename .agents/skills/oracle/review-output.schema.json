{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "authentication_impact",
    "owner_approval_status",
    "api_version_assessment",
    "review_status",
    "coverage",
    "resolutions",
    "validations",
    "limitations",
    "repair_plan",
    "protected_effects",
    "command_coverage"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "INCOMPLETE",
        "ERROR"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "line",
          "message",
          "id",
          "root_cause",
          "reproduction",
          "required_behavior",
          "recommendation",
          "affected_paths",
          "acceptance_checks",
          "origin",
          "origin_reason"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "required_behavior": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "affected_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "origin": {
            "enum": [
              "INITIAL",
              "REPAIR",
              "MISSED",
              "REOPENED"
            ]
          },
          "origin_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authentication_impact": {
      "enum": [
        "AUTHENTICATION",
        "NONE"
      ]
    },
    "owner_approval_status": {
      "enum": [
        "NOT_REQUIRED",
        "APPROVED",
        "MISSING",
        "INVALID"
      ]
    },
    "api_version_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact",
        "request_kind",
        "requested_change",
        "request_quote",
        "request_evidence"
      ],
      "properties": {
        "impact": {
          "enum": [
            "NONE",
            "CHANGE"
          ]
        },
        "request_kind": {
          "enum": [
            "NOT_REQUIRED",
            "EXPLICIT_REQUEST",
            "APPROVAL_ONLY",
            "MISSING"
          ]
        },
        "requested_change": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review_status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "ERROR"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status",
          "inputs",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REVIEWED",
              "CARRIED_FORWARD",
              "UNREVIEWED"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "explanation",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_path",
          "status",
          "inputs",
          "environment_digest",
          "reason"
        ],
        "properties": {
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "VERIFIED",
              "REUSED",
              "INVALIDATED"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "environment_digest": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repair_plan": {
      "type": "string"
    },
    "protected_effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "credential-trust",
                  "permission-authority",
                  "tenant-isolation",
                  "incompatible-public-contract"
                ]
              },
              "boundary": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "digest": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "digest"
                  ]
                }
              }
            },
            "required": [
              "id",
              "kind",
              "boundary",
              "description",
              "paths",
              "inputs"
            ]
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "origin": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "SUPERSEDED",
                  "REVERTED"
                ]
              },
              "reason": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "digest": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "digest"
                  ]
                }
              }
            },
            "required": [
              "origin",
              "id",
              "status",
              "reason",
              "inputs"
            ]
          }
        }
      },
      "required": [
        "active",
        "dispositions"
      ]
    },
    "command_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "status",
          "basis",
          "inputs",
          "evidence_paths",
          "environment_digest",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "COMPLETE",
              "INCOMPLETE"
            ]
          },
          "basis": {
            "enum": [
              "INDEPENDENT_APPLICABILITY"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "environment_digest": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
