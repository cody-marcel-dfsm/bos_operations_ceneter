{
  "name": "video-ads",
  "version": "0.1.3",
  "description": "Create, review, and deliver video ads through tenant-scoped BOS capabilities.",
  "settings": [
    {
      "name": "BOS API Key",
      "description": "Organization-scoped BOS agent bearer credential.",
      "envVar": "BOS_API_KEY",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "video-ads": {
      "httpUrl": "https://dfsm.ai/mcp/apps/leaddirector/video-ads",
      "headers": {
        "Authorization": "Bearer ${BOS_API_KEY}"
      }
    }
  }
}
