{
  "name": "icode-operations-center",
  "version": "0.4.18",
  "description": "Authorized school operations for adult iCode staff through the tenant-scoped BOS MCP.",
  "settings": [
    {
      "name": "BOS API Key",
      "description": "Organization-scoped BOS agent bearer credential.",
      "envVar": "BOS_API_KEY",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "icode-operations": {
      "httpUrl": "https://dfsm.ai/mcp/apps/leaddirector/icode-operations",
      "headers": {
        "Authorization": "Bearer ${BOS_API_KEY}"
      }
    }
  }
}
