#!/usr/bin/env python3
"""Block private Vault content from entering Git history."""

import subprocess
import sys


def _git_paths(*arguments: str) -> list[str] | None:
    result = subprocess.run(
        ["git", *arguments],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    return [line for line in result.stdout.splitlines() if line]
def main() -> int:
    staged = _git_paths(
        "diff", "--cached", "--name-only", "--diff-filter=ACMRTD", "--", "Vault"
    )
    if staged is None:
        return 1
    if staged:
        print(
            "Commit blocked: Vault/ is private maintainer material and must "
            "never enter Git history.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
