#!/usr/bin/env python3
"""Keep independent approval claims out of ordinary authored commit messages."""
from pathlib import Path
import re
import sys

if re.search(r"(?m)^Oracle-(?:Verdict|Reviewed-Tree|Receipt-SHA256):", Path(sys.argv[1]).read_text()):
    print("Oracle approval is published through the exact-commit native status; remove manual approval trailers.", file=sys.stderr)
    raise SystemExit(1)
