{
  "schema_version": "1",
  "discovery_contract_max_age_seconds": 300,
  "freshness_defaults_seconds": {
    "exact_record": 60,
    "pipeline_state": 120,
    "record_search": 300,
    "activity_timeline": 600
  },
  "merged_view": {
    "resolution_owner": "server",
    "preserve_source_provenance": true,
    "preserve_match_confidence": true
  },
  "mutation": {
    "require_explicit_authoritative_source": true,
    "require_explicit_fields": true,
    "require_exact_targets": true,
    "require_user_confirmation": true,
    "client_recovery_attempts": 0,
    "follow_server_reconciliation_action": true,
    "terminal_uncertain_state": "user_action_required"
  }
}
