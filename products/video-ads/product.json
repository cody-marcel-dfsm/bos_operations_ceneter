{
  "schema_version": "1",
  "name": "video-ads",
  "version": "0.1.3",
  "release_status": "disabled",
  "display_name": "Video Ads",
  "description": "Create, review, and deliver video ads through tenant-scoped BOS capabilities.",
  "brand_color": "#061638",
  "composer_icon": "assets/marketing-director-logo.png",
  "logo": "assets/marketing-director-logo.png",
  "publisher": "Infinite State Machines LLC",
  "category": "Marketing",
  "authentication": "ON_USE",
  "dependencies": [
    "bos"
  ],
  "runtime": "bos",
  "application_name": "leaddirector",
  "mcp_group_name": "video-ads",
  "mcp_resource_url": "https://dfsm.ai/mcp/apps/leaddirector/video-ads",
  "codex_mcp_startup_timeout_sec": 180,
  "codex_mcp_tool_timeout_sec": 180,
  "oauth": {
    "authorization_server_issuer": "https://dfsm.ai",
    "authorization_endpoint": "https://dfsm.ai/api/v1/mcp/oauth/authorize",
    "identity_provider": "google",
    "identity_provider_authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "provider_account_selection_policy": "ALWAYS_SELECT_ACCOUNT",
    "provider_account_selection_prompt": "select_account"
  },
  "plugin_settings_initializer": "bos-plugin-settings-initialization",
  "clients": [
    "codex",
    "claude",
    "copilot",
    "gemini"
  ],
  "includes": [
    "platform/bos-mcp-client",
    "platform/bos-plugin-settings",
    "platform/bos-plugin-settings-initialization",
    "platform/submit-feedback",
    "platform/manage-customer-extension",
    "capabilities/video-ad-briefing",
    "capabilities/video-ad-generation",
    "capabilities/video-ad-drive-delivery"
  ],
  "default_prompts": [
    "Turn this offer into a production-ready video ad brief.",
    "Generate a video ad from this approved brief.",
    "Save the approved video ad and its metadata to Google Drive."
  ]
}
